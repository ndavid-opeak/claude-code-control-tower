{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@server/*": [
        "../src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "../src/sessions/types.ts",
    "../src/analyzer/types.ts"
  ]
}
